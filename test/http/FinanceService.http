@baseUrl = http://localhost:4004/finance
@paymentAdjustmentId = f0000000-0000-0000-0000-000000000001
@invoiceStatusId = a0000000-0000-0000-0000-000000000002
@claimId = b0000000-0000-0000-0000-000000000002

### List payments / adjustments
GET {{baseUrl}}/PaymentAdjustments?$select=refNo,submittedOn,paymentType,instrumentType,instrumentUtrNo,paymentDate,amount,currency,fileName,status,modifiedAt

### Read one payment / adjustment
GET {{baseUrl}}/PaymentAdjustments({{paymentAdjustmentId}})

### Download attached document
POST {{baseUrl}}/PaymentAdjustments({{paymentAdjustmentId}})/FinanceService.downloadDocument
Content-Type: application/json

{}

GET {{baseUrl}}/getInvoiceStatuses()

GET {{baseUrl}}/getInvoiceStatus(ID={{invoiceStatusId}})

GET {{baseUrl}}/getClaims()

GET {{baseUrl}}/getClaim(ID={{claimId}})
